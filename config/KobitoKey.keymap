#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_kl_lang2 {
            timeout-ms = <50>;
            key-positions = <17 18>;
            bindings = <&kp LANG2>;
        };

        combo_copy {
            timeout-ms = <50>;
            key-positions = <6 7>;
            bindings = <&kp RC(C)>;
        };

        combo_paste {
            timeout-ms = <50>;
            key-positions = <7 8>;
            bindings = <&kp RC(V)>;
        };

        combo_del {
            timeout-ms = <50>;
            key-positions = <8 9>;
            layers = <0 1>;
            bindings = <&kp DEL>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    macros {
        macro_s: macro_s {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp H &kp O &kp N &kp N &kp A &kp D &kp A &kp I>;
            label = "MACRO_S";
        };

        macro_d: macro_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&kp LS(A) &kp N2 &kp N9 &kp N5 &kp X &kp P>;
            label = "MACRO_D";
        };

        bt0_jis: bt0_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "BT0_JIS";
        };

        bt1_us: bt1_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 1 &to 0>;
            label = "BT1_US";
        };

        bt2_us: bt2_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 2 &to 1>;
            label = "BT2_US";
        };

        bt3_us: bt3_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 3 &to 1>;
            label = "BT3_US";
        };

        bt4_us: bt4_us {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&bt BT_SEL 4 &to 1>;
            label = "BT4_US";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* [0] DEF (JIS OS用) */

        default_layer {
            label = "DEF";
            bindings = <
&kp Q                &kp W     &kp E      &kp R        &kp T       &kp Y     &kp U        &kp I        &kp O        &lt 7 P
&mt LEFT_CONTROL A   &kp S     &kp D      &kp F        &kp G       &kp H     &kp J        &kp K        &kp L        &mt RIGHT_CONTROL MINUS
&mt LSHFT Z          &kp X     &kp C      &kp V        &kp B       &kp N     &kp M        &kp COMMA    &kp DOT      &mt RSHFT SLASH
&mt LCMD LANGUAGE_2  &kp LALT  &kp LSHFT  &lt 5 SPACE  &lt 10 TAB  &kp BSPC  &lt 3 ENTER  &lt 5 LSHFT  &lt 8 UNDER  &lt 8 LANGUAGE_1
            >;
        };

        /* [1] US_D (US OS用) */

        us_defo {
            label = "US_D";
            bindings = <
&kp Q               &kp W     &kp E      &kp R        &kp T      &kp Y     &kp U        &kp I        &kp O        &lt 7 P
&mt LEFT_CONTROL A  &kp S     &kp D      &kp F        &kp G      &kp H     &kp J        &kp K        &kp L        &mt RIGHT_CONTROL MINUS
&mt LSHFT Z         &kp X     &kp C      &kp V        &kp B      &kp N     &kp M        &kp COMMA    &kp DOT      &mt RSHFT SLASH
&kp LCMD            &kp LALT  &kp LSHFT  &lt 4 SPACE  &lt 9 TAB  &kp BSPC  &lt 2 ENTER  &lt 4 LSHFT  &lt 8 MINUS  &lt 8 RIGHT_ALT
            >;
        };

        /* [2] ARROW_US (ENTER長押し / US_D側) */

        ARROW_US {
            label = "ARROW_US";
            bindings = <
&kp SLASH     &kp N7  &kp N8  &kp N9  &kp MINUS  &kp RS(RG(LEFT))  &kp F2    &kp UP    &kp F4     &kp RS(RG(RIGHT))
&kp ASTERISK  &kp N4  &kp N5  &kp N6  &kp PLUS   &kp RA(LEFT)      &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans        &kp N1  &kp N2  &kp N3  &trans     &trans            &kp F7    &trans    &kp F8     &kp F11
&trans        &kp N0  &kp N0  &kp N0  &trans     &trans            &trans    &trans    &kp F12    &trans
            >;
        };

        /* [3] ARROW_JIS (ENTER長押し / DEF側、表示文字はARROW_USと同じ) */

        ARROW_JIS {
            label = "ARROW_JIS";
            bindings = <
&kp SLASH    &kp N7  &kp N8  &kp N9  &kp MINUS     &kp RS(RG(LEFT))  &kp F2    &kp UP    &kp F4     &kp RS(RG(RIGHT))
&kp LS(SQT)  &kp N4  &kp N5  &kp N6  &kp LS(SEMI)  &kp RA(LEFT)      &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&trans       &kp N1  &kp N2  &kp N3  &trans        &trans            &kp F7    &trans    &kp F8     &kp F11
&trans       &kp N0  &kp N0  &kp N0  &trans        &trans            &trans    &trans    &kp F12    &trans
            >;
        };

        /* [4] NUM_US (SPACE長押し / US_D側) */

        NUM_US {
            label = "NUM_US";
            bindings = <
&kp PAGE_UP  &kp F2    &kp UP    &kp F4     &kp MINUS     &kp SLASH     &kp N7  &kp N8  &kp N9        &kp MINUS
&trans       &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(SEMI)  &kp ASTERISK  &kp N4  &kp N5  &kp N6        &kp PLUS
&kp N0       &kp F7    &kp F8    &kp F11    &trans        &kp DOT       &kp N1  &kp N2  &kp N3        &kp ENTER
&trans       &trans    &trans    &trans     &trans        &trans        &kp N0  &kp N0  &kp NUMBER_0  &trans
            >;
        };

        /* [5] NUM_JIS (SPACE長押し / DEF側、表示文字はNUM_USと同じ) */

        NUM_JIS {
            label = "NUM_JIS";
            bindings = <
&kp PAGE_UP  &kp F2    &kp UP    &kp F4     &kp MINUS     &kp SLASH    &kp N7  &kp N8  &kp N9   &kp MINUS
&trans       &kp LEFT  &kp DOWN  &kp RIGHT  &kp LS(SEMI)  &kp RS(SQT)  &kp N4  &kp N5  &kp N6   &kp RS(SEMICOLON)
&kp N0       &kp F7    &kp F8    &kp F11    &trans        &kp DOT      &kp N1  &kp N2  &kp N3   &kp ENTER
&trans       &trans    &trans    &trans     &trans        &trans       &kp N0  &kp N0  &kp DOT  &trans
            >;
        };

        /* [6] MOUSE (自動発動は既存の小人キー方式、5秒でレイヤーを抜ける) */

        MOUSE {
            label = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &kp C_AC_BACK  &mkp MB1  &mkp MB3  &mkp MB2   &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans    &kp RC(C)  &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans    &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans         &trans    &trans    &trans     &trans
            >;
        };

        /* [7] SCROLL (Pキー長押しで直接呼び出し) */

        SCROLL {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        /* [8] SYSTEM (BT選択・マクロ・bootloader) */

        SYSTEM {
            label = "SYSTEM";
            bindings = <
&bt0_jis    &bt1_us         &bt2_us   &bt3_us   &bt4_us  &trans  &trans  &trans  &trans  &trans
&trans      &macro_s        &macro_d  &macro_s  &trans   &trans  &trans  &trans  &trans  &trans
&bt BT_CLR  &bt BT_CLR_ALL  &kp N2    &kp N3    &trans   &trans  &trans  &trans  &trans  &trans
&trans      &trans          &trans    &trans    &trans   &trans  &trans  &trans  &trans  &bootloader
            >;
        };

        /* [9] US_MAP (TAB長押し / US_D側) */

        US_MAP {
            label = "US_MAP";
            bindings = <
&kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N9)     &kp LS(N0)   &kp EQUAL
&kp TILDE   &trans      &macro_s    &macro_d    &kp SLASH   &kp APOS    &kp COLON   &kp LBKT       &kp RBKT     &kp LS(MINUS)
&kp GRAVE   &trans      &trans      &trans      &trans      &kp DQT     &kp SEMI    &kp LS(COMMA)  &kp LS(DOT)  &kp LS(SLASH)
&trans      &trans      &trans      &trans      &trans      &kp DELETE  &trans      &trans         &trans       &trans
            >;
        };

        /* [10] JIS_MAP (TAB長押し / DEF側、表示文字はUS_MAPと同じ) */

        JIS_MAP {
            label = "JIS_MAP";
            bindings = <
&kp LS(N1)     &kp LBKT  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)     &kp LS(N9)   &kp LS(MINUS)
&kp LS(EQUAL)  &trans    &macro_s    &macro_d    &kp SLASH   &kp LS(N7)  &kp SQT     &kp RBKT       &kp BSLH     &kp LS(INT1)
&kp LS(LBKT)   &trans    &trans      &trans      &trans      &kp LS(N2)  &kp SEMI    &kp LS(COMMA)  &kp LS(DOT)  &kp LS(SLASH)
&trans         &trans    &trans      &trans      &trans      &kp DELETE  &trans      &trans         &trans       &trans
            >;
        };
    };
};
